Options -Indexes -ExecCGI
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:includes|storage|source-materials)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:p|news)/([A-Za-z0-9\x{0600}-\x{06FF}-]+)/?$ page.php?slug=$1 [QSA,L,B]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

<FilesMatch "(^\.|\.(sqlite|sqlite3|db|key|log|ini|md|bak|sql)$|^(composer\.(json|lock)|update\.json)$)">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_value upload_max_filesize 150M
  php_value post_max_size 155M
  php_value max_execution_time 180
  php_flag display_errors Off
  php_flag session.use_strict_mode On
  php_flag session.cookie_httponly On
</IfModule>
